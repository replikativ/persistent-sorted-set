{:paths ["src-clojure" "target/classes"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.0"}
  is.simm/partial-cps {:mvn/version "0.1.59"}}
 :deps/prep-lib {:ensure "target/classes"
                 :alias :build
                 :fn java}
 :aliases
 {:dev
  {:extra-deps
   {nrepl/nrepl {:mvn/version "1.0.0"}}
   :extra-paths ["test-clojure" "dev"]
   :jvm-opts    ["-ea"]}

  :cljs
  {:extra-deps {org.clojure/clojurescript {:mvn/version "1.12.42"}}}

  :node-tests
  {:extra-paths ["test-clojure"]
   ;; fress, boring and transit-cljs are the ClojureScript sides of the three codec
   ;; handler tests. shadow-cljs takes its classpath from these aliases, so a codec
   ;; missing here is a build failure ("The required namespace is not
   ;; available"), not a skipped test.
   :extra-deps {thheller/shadow-cljs {:mvn/version "3.2.0"}
                org.clojure/test.check {:mvn/version "1.1.1"}
                com.github.pkpkpk/fress {:mvn/version "0.4.312"}
                org.replikativ/boring {:mvn/version "0.1.6"}
                com.cognitect/transit-cljs {:mvn/version "0.8.280"}
                org.replikativ/hasch {:mvn/version "0.4.98"}}}

  :node-stress
  {:extra-paths ["test-clojure"]
   :extra-deps {thheller/shadow-cljs {:mvn/version "3.2.0"}
                org.clojure/test.check {:mvn/version "1.1.1"}
                org.replikativ/hasch {:mvn/version "0.4.98"}}}

  :build
  {:extra-deps {io.github.clojure/tools.build {:git/tag "v0.8.5" :git/sha "9c738da" #_#_:exclusions [org.slf4j/slf4j-nop]}
                slipset/deps-deploy {:mvn/version "0.2.0"}
                io.github.borkdude/gh-release-artifact {:git/tag "v0.2.1" :git/sha "4a9a74f"}}
   :ns-default build}

  ;; The optional Fressian node-handler ns (org.replikativ.persistent-sorted-set.fressian)
  ;; treats data.fressian as `provided` for consumers; here it's a plain dev/test dep.
  :fressian
  {:extra-deps {org.clojure/data.fressian {:mvn/version "1.1.0"}}}

  ;; Same arrangement for the cbor and transit node-handler namespaces:
  ;; `provided` for consumers, plain dev/test deps here. A consumer pulls in only
  ;; the codec it actually uses. The namespace is named for the FORMAT; boring is
  ;; the library that implements it.
  :cbor
  {:extra-deps {org.replikativ/boring {:mvn/version "0.1.6"}}}

  ;; BOTH transit artifacts: `transit.cljc` requires `cognitect.transit` from shared
  ;; (non-reader-conditional) code, and the two platforms ship it in two different
  ;; jars -- transit-clj carries only `cognitect/transit.clj`. With transit-clj
  ;; alone the module loads on the JVM and a ClojureScript consumer gets
  ;; "namespace cognitect.transit is not available", so the JVM half of the alias
  ;; silently certified a module that could not build for half its platforms.
  :transit
  {:extra-deps {com.cognitect/transit-clj  {:mvn/version "1.0.333"}
                com.cognitect/transit-cljs {:mvn/version "0.8.280"}}}

  :test
  ;; test-resources carries the golden pre-refactor Fressian blobs that
  ;; test.fressian-compat asserts against (as a classpath resource).
  {:extra-paths ["test-clojure" "test-resources"]
   :extra-deps  {io.github.cognitect-labs/test-runner {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                 org.clojure/test.check {:mvn/version "1.1.1"}
                 org.clojure/data.fressian {:mvn/version "1.1.0"}
                 ;; Same reason data.fressian is here: the codec namespaces are
                 ;; `provided` for consumers, but their handler tests are part of
                 ;; the suite. Without this, test.cbor-handlers fails to LOAD and
                 ;; takes the whole run with it.
                 org.replikativ/boring {:mvn/version "0.1.6"}
                 com.cognitect/transit-clj {:mvn/version "1.0.333"}
                 org.replikativ/hasch {:mvn/version "0.4.98"}}
   ;; diff-buf: library default is 0 (baseline). Run the suite with diff-buf ON so it
   ;; gates the buffering path; baseline-only invariant tests pin {:diff-buf-size 0} to override.
   ;; -ea enables the in-tree assertions — notably the diff-buf store() oracle that cross-checks
   ;; the maintained _bufEntries against a fresh subtree walk, plus the projection invariants.
   :jvm-opts    ["-Dpss.diffBufSize=256" "-ea"]
   :main-opts   ["-m" "cognitect.test-runner"
                  "-d" "test-clojure"
                  "-r" "org\\.replikativ\\.persistent-sorted-set\\.test.*"]
   :exec-fn     cognitect.test-runner.api/test
   :exec-args   {:dirs ["test-clojure"]
                 :patterns ["org\\.replikativ\\.persistent-sorted-set\\.test.*"]}}

  :bench
  {:extra-paths ["test-clojure" "bench-clojure"]
   :extra-deps
   {com.clojure-goes-fast/clj-async-profiler {:mvn/version "1.0.0"}
    criterium/criterium                      {:mvn/version "0.4.6"}}
   :jvm-opts    ["-server"
                 "-Duser.language=en-US"
                 "-Djdk.attach.allowAttachSelf"
                 "-XX:+UnlockDiagnosticVMOptions"
                 "-XX:+DebugNonSafepoints"]}

  :format
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "check" "src-clojure" "test-clojure"]}

  :ffix
  {:extra-deps {cljfmt/cljfmt {:mvn/version "0.9.2"}}
   :main-opts ["-m" "cljfmt.main" "fix" "src-clojure" "test-clojure"]}}}
