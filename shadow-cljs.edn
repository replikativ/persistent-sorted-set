{:deps {:aliases [:node-tests :node-stress]},
 :source-paths ["src-clojure" "test-clojure"]
 :builds
 {:node-tests
  {:target    :node-test  ;shadow-cljs release node-tests && node target/pss/tests.min.js
   :output-to "target/pss/tests.min.js"
   ;; Excludes only `stress` (runs in :node-stress). generative.cljc is cross-platform
   ;; (#?(:cljs …) storage branches) so it runs here too. (The old `structural-invariants`
   ;; exclusion was dead — no such namespace.)
   :ns-regexp "^(?!org.replikativ.persistent-sorted-set.test.stress)"
   ;; diff-buf: library default is 0 (baseline); run the test suite with diff-buf ON so
   ;; it gates the buffering path (the cljs analogue of -Dpss.diffBufSize=256 on the JVM).
   :closure-defines {org.replikativ.persistent-sorted-set/default-diff-buf-size 256}
   :compiler-options {:infer-externs true
                      :parallel-build true
                      :static-fns true
                      :fn-invoke-direct true
                      ;; keep in-tree assertions live in the test build (cljs analogue of -ea)
                      :elide-asserts false
                      :optimizations :advanced}}
  :node-stress ;shadow-cljs release node-stress && node target/pss/stress.min.js
  {:target    :node-test
   :output-to "target/pss/stress.min.js"
   :ns-regexp "^org.replikativ.persistent-sorted-set.test.stress"
   :compiler-options {:infer-externs true
                      :parallel-build true
                      :static-fns true
                      :fn-invoke-direct true
                      ;; keep in-tree assertions live in the stress build too
                      :elide-asserts false
                      :optimizations :advanced}}
  :ci ;shadow-cljs compile ci && node target/pss/ci-tests.js
  ;; MUST track :node-tests. This build is what CI actually runs, and it had drifted
  ;; into testing materially less than the local suite:
  ;;
  ;;   * no :closure-defines, so `default-diff-buf-size` fell back to the library
  ;;     default of 0 — every test that does not pass :diff-buf-size explicitly ran
  ;;     with buffering OFF. The diff-buf path is where BOTH cljs defects of this
  ;;     cycle lived (the replace-deposit key, the nested-diff assembly), so CI could
  ;;     never have caught either one.
  ;;   * it also skipped `storage` and `generative`, plus `structural-invariants`,
  ;;     which does not exist (a dead exclusion, already noted on :node-tests).
  ;;
  ;; The classpath comes from the shared :deps aliases above, so none of those
  ;; exclusions was dependency-driven — they were just stale.
  {:target    :node-test
   :output-to "target/pss/ci-tests.js"
   :ns-regexp "^(?!org.replikativ.persistent-sorted-set.test.stress)"
   :closure-defines {org.replikativ.persistent-sorted-set/default-diff-buf-size 256}
   :compiler-options {:infer-externs true
                      :parallel-build false
                      :static-fns true
                      :fn-invoke-direct true
                      :elide-asserts false
                      :optimizations :advanced}}
  :node-repl ;shadow-cljs node-repl
  {:target :node-script
   :main org.replikativ.persistent-sorted-set/sorted-set
   :output-to "target/repl.js"}}}